# Server
PORT=3001
# Comma separated list of origins allowed to call the public chat API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (MySQL). Locally this is WAMP's MySQL; on Vercel use a MySQL that is reachable from the internet.
# Either set DATABASE_URL=mysql://user:password@host:3306/dbname or the DB_* values below.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chatbot
# Set to true for hosted MySQL that requires TLS
DB_SSL=false

# Auth (change JWT_SECRET to a long random string)
JWT_SECRET=change-me
# First admin account, created on first start when the users table is empty
SEED_ADMIN_EMAIL=admin@askanythinganswers.com
SEED_ADMIN_PASSWORD=change-me-now

# OpenAI (leave OPENAI_API_KEY empty to use built-in scripted replies)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Chat behaviour
ANSWER_TURNS=4
MAX_USER_WORDS=50
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=3000
